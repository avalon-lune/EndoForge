* text=auto

# Unreal binary assets must be hydrated through Git LFS before opening the project.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Keep code/document diffs stable across Windows checkouts.
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Small, selected README screenshots are ordinary Git objects.
*.png binary
*.jpg binary
*.jpeg binary

# Accepted simulation inputs and asset contracts use byte-level SHA-256 identities.
# Preserve their authored line endings across checkout; text diffs still work.
/Assets/** -text !eol
/Physics/** -text !eol
/Prototype/LapTrainer/Source/** -text !eol
/Prototype/LapTrainer/Config/** -text !eol
/Prototype/LapTrainer/Scripts/** -text !eol
/Prototype/LapTrainer/LapTrainer.uproject -text !eol
/Scripts/** -text !eol
